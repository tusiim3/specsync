# SpecSync reads these from the environment or from a .env file in the
# directory you run it from. Set ONE provider key; auto mode picks the first
# available in this order: Gemini, Anthropic, OpenAI, then a local Ollama.

# Google Gemini (free tier works): https://aistudio.google.com
GEMINI_API_KEY=

# Anthropic Claude: https://console.anthropic.com
ANTHROPIC_API_KEY=

# OpenAI: https://platform.openai.com
OPENAI_API_KEY=

# Ollama (local, no key): defaults to http://localhost:11434
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen3:8b

# Override the model for whichever provider is used
# SPECSYNC_MODEL=

# Embeddings: auto (local model, API fallback), local, gemini or openai
# (set in specsync.config.json or with --embeddings)

# Where the local embedding model is cached (default: inside node_modules)
# SPECSYNC_MODEL_CACHE=.specsync/models
